# Réglages réseau du serveur DNS — À ADAPTER à votre maison.

# Adresse IP fixe du serveur (celle réservée dans la Freebox).
# Les trois domaines pointeront vers elle, et le DNS écoutera sur elle.
IP_SERVEUR=192.168.1.50

# Serveur DNS à qui transmettre tous les autres noms : la Freebox (192.168.1.254
# par défaut). Vous pouvez aussi mettre un DNS public, ex. « 1.1.1.1 9.9.9.9 ».
DNS_AMONT=192.168.1.254
